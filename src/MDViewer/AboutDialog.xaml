<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="MDViewer.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="О программе"
    CloseButtonText="OK"
    DefaultButton="Close"
    Style="{ThemeResource DefaultContentDialogStyle}">
    <StackPanel
        Width="320"
        HorizontalAlignment="Center"
        Spacing="0">
        <Image
            Width="72"
            Height="72"
            Margin="0,8,0,16"
            HorizontalAlignment="Center"
            Source="Assets/Logo.png" />

        <TextBlock
            HorizontalAlignment="Center"
            FontSize="18"
            FontWeight="SemiBold"
            Text="Просмотр Markdown" />

        <TextBlock
            x:Name="VersionText"
            Margin="0,10,0,14"
            HorizontalAlignment="Center"
            FontSize="13"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Номер версии: 0.1.0" />

        <HyperlinkButton
            Padding="0"
            HorizontalAlignment="Center"
            Content="Скачать актуальный релиз на GitHub"
            FontSize="13"
            NavigateUri="https://github.com/yurymikitchuk/MDViewer/releases/latest" />
    </StackPanel>
</ContentDialog>
