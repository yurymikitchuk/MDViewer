<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MDViewer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MDViewer"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Просмотр Markdown"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="Transparent"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop"
        KeyboardAcceleratorPlacementMode="Hidden">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="ChromeTop">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid x:Name="TitleBarRoot" Background="Transparent">
                <Border
                    x:Name="TitleBarDrag"
                    Margin="300,0,140,0"
                    Background="Transparent" />

                <TextBlock
                    x:Name="TitleText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12"
                    IsHitTestVisible="False"
                    Text="Просмотр Markdown"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel
                    Margin="8,0,0,0"
                    Orientation="Horizontal"
                    Spacing="4"
                    VerticalAlignment="Center">
                    <Image
                        Width="16"
                        Height="16"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Source="Assets/MDViewer_32.png" />

                    <!-- MenuBar provides classic Windows hot-tracking between top-level menus -->
                    <MenuBar
                        x:Name="AppMenuBar"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        UseSystemFocusVisuals="False">
                        <MenuBar.Resources>
                            <Style TargetType="MenuBarItem">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="UseSystemFocusVisuals" Value="False" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Padding" Value="10,4" />
                                <Setter Property="CornerRadius" Value="4" />
                            </Style>
                        </MenuBar.Resources>
                        <MenuBarItem x:Name="FileMenuBarItem" Title="Файл">
                            <MenuFlyoutItem
                                Click="OpenMenu_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+O"
                                Text="Открыть…" />
                            <MenuFlyoutSubItem x:Name="RecentMenu" Text="Недавние файлы" />
                            <MenuFlyoutItem
                                x:Name="ReloadMenuItem"
                                Click="ReloadMenu_Click"
                                IsEnabled="False"
                                KeyboardAcceleratorTextOverride="F5"
                                Text="Обновить" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="PrintMenuItem"
                                Click="PrintMenu_Click"
                                IsEnabled="False"
                                KeyboardAcceleratorTextOverride="Ctrl+P"
                                Text="Печать…" />
                            <MenuFlyoutItem
                                x:Name="ExportPdfMenuItem"
                                Click="ExportPdfMenu_Click"
                                IsEnabled="False"
                                KeyboardAcceleratorTextOverride="Ctrl+E"
                                Text="Экспорт в PDF…" />
                            <MenuFlyoutItem
                                x:Name="CopyTextMenuItem"
                                Click="CopyTextMenu_Click"
                                IsEnabled="False"
                                Text="Копировать как текст" />
                            <MenuFlyoutItem
                                x:Name="CopyHtmlMenuItem"
                                Click="CopyHtmlMenu_Click"
                                IsEnabled="False"
                                Text="Копировать как HTML" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem Text="Настройки">
                                <MenuFlyoutItem
                                    Click="UnregisterAssociations_Click"
                                    Text="Убрать из «Открыть с помощью»" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem Click="ExitMenu_Click" Text="Выход" />
                        </MenuBarItem>

                        <MenuBarItem Title="Вид">
                            <MenuFlyoutItem
                                x:Name="FindMenuItem"
                                Click="FindMenu_Click"
                                IsEnabled="False"
                                KeyboardAcceleratorTextOverride="Ctrl+F"
                                Text="Найти" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem
                                x:Name="TocToggleMenuItem"
                                Click="TocToggle_Click"
                                Text="Оглавление" />
                            <ToggleMenuFlyoutItem
                                x:Name="StatusBarToggleMenuItem"
                                Click="StatusBarToggle_Click"
                                Text="Строка состояния" />
                            <MenuFlyoutSubItem Text="Тема">
                                <ToggleMenuFlyoutItem
                                    x:Name="ThemeSystemItem"
                                    Click="ThemeSystem_Click"
                                    Text="Как в системе" />
                                <ToggleMenuFlyoutItem
                                    x:Name="ThemeLightItem"
                                    Click="ThemeLight_Click"
                                    Text="Светлая" />
                                <ToggleMenuFlyoutItem
                                    x:Name="ThemeDarkItem"
                                    Click="ThemeDark_Click"
                                    Text="Тёмная" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                Click="ZoomIn_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+↑ колесо"
                                Text="Увеличить" />
                            <MenuFlyoutItem
                                Click="ZoomOut_Click"
                                KeyboardAcceleratorTextOverride="Ctrl+↓ колесо"
                                Text="Уменьшить" />
                            <MenuFlyoutItem
                                Click="ZoomReset_Click"
                                Text="Сбросить масштаб" />
                        </MenuBarItem>

                        <MenuBarItem Title="Справка">
                            <MenuFlyoutItem
                                Click="MarkdownSyntaxHelp_Click"
                                Text="Синтаксис Markdown" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="AboutMenu_Click" Text="О программе" />
                        </MenuBarItem>
                    </MenuBar>
                </StackPanel>
            </Grid>

            <Border
                x:Name="FindBar"
                Grid.Row="1"
                Padding="12,4,12,6"
                Background="Transparent"
                BorderBrush="{ThemeResource ChromeBorderBrush}"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="FindBox"
                        MinHeight="28"
                        Padding="8,4"
                        FontSize="13"
                        PlaceholderText="Найти"
                        TextChanged="FindBox_TextChanged"
                        KeyDown="FindBox_KeyDown" />
                    <TextBlock
                        x:Name="FindStatus"
                        Grid.Column="1"
                        MinWidth="56"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="" />
                    <Button
                        Grid.Column="2"
                        Click="FindPrev_Click"
                        Content="↑"
                        FontSize="13"
                        Style="{StaticResource ChromeFlatButtonStyle}" />
                    <Button
                        Grid.Column="3"
                        Click="FindNext_Click"
                        Content="↓"
                        FontSize="13"
                        Style="{StaticResource ChromeFlatButtonStyle}" />
                    <Button
                        Grid.Column="4"
                        Click="FindClose_Click"
                        Content="✕"
                        FontSize="12"
                        Style="{StaticResource ChromeFlatButtonStyle}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TocColumn" Width="0" />
                <ColumnDefinition x:Name="TocSplitterColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="TocPanel"
                Background="{ThemeResource ChromeSurfaceBrush}"
                BorderBrush="{ThemeResource ChromeBorderBrush}"
                BorderThickness="0,0,1,0"
                Visibility="Collapsed">
                <Border.ContextFlyout>
                    <MenuFlyout x:Name="TocContextFlyout" Opening="TocContextFlyout_Opening">
                        <MenuFlyoutItem Click="TocGoTop_Click" Text="К началу документа" />
                        <MenuFlyoutItem
                            x:Name="TocGoCurrentMenuItem"
                            Click="TocGoCurrent_Click"
                            Text="К текущему разделу" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem Text="Уровень заголовков">
                            <RadioMenuFlyoutItem
                                x:Name="TocLevel1MenuItem"
                                Click="TocLevelMenu_Click"
                                GroupName="TocLevel"
                                Tag="1"
                                Text="Только H1" />
                            <RadioMenuFlyoutItem
                                x:Name="TocLevel2MenuItem"
                                Click="TocLevelMenu_Click"
                                GroupName="TocLevel"
                                Tag="2"
                                Text="H1–H2" />
                            <RadioMenuFlyoutItem
                                x:Name="TocLevel3MenuItem"
                                Click="TocLevelMenu_Click"
                                GroupName="TocLevel"
                                Tag="3"
                                Text="H1–H3" />
                            <RadioMenuFlyoutItem
                                x:Name="TocLevel4MenuItem"
                                Click="TocLevelMenu_Click"
                                GroupName="TocLevel"
                                Tag="4"
                                Text="H1–H4" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Name="TocCopyMenuItem"
                            Click="TocCopy_Click"
                            Text="Копировать оглавление" />
                        <MenuFlyoutItem
                            x:Name="TocCopyLinkMenuItem"
                            Click="TocCopyLink_Click"
                            Text="Копировать ссылку на заголовок" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutSubItem Text="Ширина панели">
                            <MenuFlyoutItem Click="TocWidthNarrower_Click" Text="Уже" />
                            <MenuFlyoutItem Click="TocWidthWider_Click" Text="Шире" />
                            <MenuFlyoutItem Click="TocWidthReset_Click" Text="Сбросить" />
                        </MenuFlyoutSubItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="TocHide_Click" Text="Скрыть оглавление" />
                    </MenuFlyout>
                </Border.ContextFlyout>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="12,10,12,4"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Оглавление" />
                    <Grid Grid.Row="1">
                        <ListView
                            x:Name="TocList"
                            SelectionMode="Single"
                            IsItemClickEnabled="True"
                            ItemClick="TocList_ItemClick"
                            RightTapped="TocList_RightTapped">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:TocItem">
                                    <TextBlock
                                        Margin="{x:Bind Indent}"
                                        Text="{x:Bind Text}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="TocEmptyHint"
                            Margin="12,8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Нет заголовков"
                            Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>

            <Border
                x:Name="TocSplitter"
                Grid.Column="1"
                Width="4"
                Background="Transparent"
                PointerCanceled="TocSplitter_PointerCanceled"
                PointerCaptureLost="TocSplitter_PointerCaptureLost"
                PointerMoved="TocSplitter_PointerMoved"
                PointerPressed="TocSplitter_PointerPressed"
                PointerReleased="TocSplitter_PointerReleased"
                Visibility="Collapsed" />

            <Grid Grid.Column="2">
                <Grid
                    x:Name="EmptyState"
                    Background="{ThemeResource AppBackgroundBrush}"
                    Opacity="1">
                    <StackPanel
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="10">
                        <Image
                            Width="96"
                            Height="96"
                            HorizontalAlignment="Center"
                            Source="Assets/Logo.png" />
                        <Button
                            Margin="0,6,0,0"
                            HorizontalAlignment="Center"
                            Click="OpenMenu_Click"
                            Content="Открыть"
                            Style="{StaticResource OpenPrimaryButtonStyle}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="или перетащи markdown-файл сюда"
                            TextAlignment="Center"
                            TextWrapping="WrapWholeWords" />
                        <StackPanel
                            x:Name="EmptyRecentPanel"
                            Margin="0,8,0,0"
                            Spacing="2"
                            Visibility="Collapsed">
                            <TextBlock
                                Margin="0,0,0,4"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Недавние файлы" />
                            <StackPanel x:Name="EmptyRecentList" Spacing="0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <WebView2
                    x:Name="Viewer"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

        <Border
            x:Name="StatusBar"
            Grid.Row="2"
            Padding="12,6"
            Background="{ThemeResource ChromeSurfaceBrush}"
            BorderBrush="{ThemeResource ChromeBorderBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                x:Name="StatusText"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Готово" />
        </Border>
    </Grid>
</Window>
